{
  "name": "screenclaw-desktop",
  "version": "1.0.0",
  "description": "ScreenClaw-like desktop recorder (Electron + Angular), Windows-only.",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "npm run electron:serve",
    "electron:serve": "npm run angular:serve & npm run electron:watch",
    "electron:watch": "wait-on dist-electron/main.js && electron .",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:watch-build": "tsc -p electron/tsconfig.json --watch",
    "angular:serve": "ng serve",
    "angular:build": "ng build",
    "build": "npm run electron:build && npm run angular:build",
    "package": "npm run build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "~0.14.10"
  }
}
